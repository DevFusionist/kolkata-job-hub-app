modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"
packages = ["unzip"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Mobile App Preview"

[[workflows.workflow]]
name = "Run Mobile App Preview"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx expo start --port 5000 --tunnel"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
