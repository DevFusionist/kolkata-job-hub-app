{
  "expo": {
    "name": "Protibha",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "protibha",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.protibha.jobhunter"
    },

    "android": {
      "package": "com.protibha.jobhunter",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#1C1C1C"
      },
      "edgeToEdgeEnabled": true
    },

    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 400,
          "resizeMode": "contain",
          "backgroundColor": "#1C1C1C"
        }
      ]
    ],

    "experiments": {
      "typedRoutes": true
    },

    "extra": {
      "appName": "Protibha",
      "apiBaseUrl": "https://api.protibha.in",
      "router": {},
     "eas": { "projectId": "0a343a37-7a66-4f12-91fa-bf4c77a458ae" }
    }
  }
}
