{
  "expo": {
    "name": "Kormo",
    "slug": "kolkata-job-hub-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kormo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FFF8E7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "in.protibha.kormo"
    },
    "android": {
      "package": "in.protibha.kormo"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": {
            "web": true,
            "default": "development"
          }
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
